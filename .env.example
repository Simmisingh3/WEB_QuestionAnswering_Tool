# Copy this file to .env and set your own key. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=web_qa_chunks
REQUEST_TIMEOUT_SECONDS=45
MAX_URLS_PER_INGEST=10
MAX_PAGE_CHARS=200000
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=5
